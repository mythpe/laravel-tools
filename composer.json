{
  "name": "4myth/laravel-tools",
  "description": "Tools of laravel framework",
  "homepage": "https://www.4myth.com",
  "keywords": [
    "myth",
    "tools",
    "Laravel",
    "generator",
    "helpers"
  ],
  "type": "library",
  "require": {
    "php": ">=8.2",
    "laravel/framework": ">=9.0",
    "ext-curl": "*",
    "ext-zip": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^2.13",
    "fakerphp/faker": "^1",
    "laravel/pint": "^1",
    "laravel/sail": "^1",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1",
    "spatie/laravel-ignition": "^2.0",
    "simplesoftwareio/simple-qrcode": "~4",
    "maatwebsite/excel": "^3",
    "ctwillie/expo-server-sdk-php": "^2.0",
    "geniusts/hijri-dates": ">=1.0",
    "akaunting/laravel-setting": ">=1.0",
    "bavix/laravel-wallet": "^9.6",
    "beyondcode/laravel-websockets": "^1.13",
    "barryvdh/laravel-snappy": "^1.0@dev",
    "spatie/laravel-medialibrary": "^11",
    "laravel-notification-channels/fcm": "^4.5",
    "kreait/laravel-firebase": "^5.10",
    "propaganistas/laravel-phone": "^5.3",
    "symfony/intl": "^v7"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Myth\\LaravelTools\\": "src/"
    },
    "files": [
      "src/Utilities/Functions.php"
    ]
  },
  "authors": [
    {
      "name": "MyTh Ahmed Faiz",
      "email": "mythpe@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Myth\\LaravelTools\\Providers\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev"
}
