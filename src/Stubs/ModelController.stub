<?php
{copyright}

namespace App\Http\Controllers{namespace};

use App\Http\Controllers\Controller;
use App\Http\Resources{namespace}\{studlySingular}Resource as Transformer;
use App\Models{namespace}\{studlySingular} as Model;

class {studlySingular}Controller extends Controller
{
    // public const RELATIONS = [];
    public static string $indexTransformer = Transformer::class;
    public static string $controllerTransformer = Transformer::class;
    public static string $controllerModel = Model::class;
    // public array $with = self::RELATIONS;
    // protected bool $autoSavingImage = !0;
    // protected string | bool | null $oldest = !1;
    // protected string | bool | null $latest = !1;

    /**
     * @param  array  $rules
     * @param  Model|null  $model
     *
     * @return array
     */
    protected function requestRules(array &$rules = [], &$model = null): array
    {
        $rules = array_merge($rules, $this->getRules());
        return parent::requestRules($rules, $model);
    }

    /**
     * @return \string[][]
     */
    public function getRules(): array
    {
        return [
            'name_ar'  => ['required'],
            'name_en'  => ['required'],{rules}
        ];
    }
}
