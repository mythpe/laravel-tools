<?php
{copyright}

namespace App\Traits\BelongsTo{namespace};

use App\Models{namespace}\{studlySingular} as Model;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Casts\Attribute;
use Illuminate\Database\Eloquent\Model as Eloquent;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * @property-read Model ${camelSingular}
 */
trait BelongsTo{studlySingular}
{

    /**
     * @return BelongsTo
     */
    public function {camelSingular}(): BelongsTo
    {
        return $this->belongsTo(Model::class)->withDefault();
    }

    /**
     * @param  \Illuminate\Database\Eloquent\Builder  $builder
     * @param $value
     *
     * @return \Illuminate\Database\Eloquent\Builder
     */
    protected function scopeBy{studlySingular}(Builder $builder, $value): Builder
    {
        $value instanceof Eloquent && ($value = [$value->id]);
        !is_array($value) && ($value = explode(',', $value));
        return $builder->whereIn('{snakeSingular}_id', $value);
    }

    /**
     * $this->{snakeSingular}_id_to_string
     * @return Attribute
     */
    protected function {camelSingular}IdToString(): Attribute
    {
        return Attribute::get(fn() => $this->{camelSingular}->name);
    }
}
